{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@eslint-plugin-sdl-2/docs",
    "version": "0.1.0",
    "private": true,
    "description": "Docusaurus documentation site for eslint-plugin-sdl-2.",
    "keywords": [
        "docusaurus",
        "documentation",
        "eslint",
        "eslint-plugin",
        "sdl",
        "security",
        "typescript"
    ],
    "homepage": "https://nick2bad4u.github.io/eslint-plugin-SDL-2/",
    "bugs": {
        "url": "https://github.com/Nick2bad4u/eslint-plugin-SDL-2/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nick2bad4u/eslint-plugin-SDL-2.git"
    },
    "license": "MIT",
    "author": "Nick2bad4u",
    "contributors": [
        {
            "name": "Nick2bad4u",
            "email": "20943337+Nick2bad4u@users.noreply.github.com",
            "url": "https://nick2bad4u.github.io/eslint-plugin-SDL-2"
        }
    ],
    "sideEffects": false,
    "main": "docusaurus.config.ts",
    "files": [
        "site-docs"
    ],
    "scripts": {
        "build": "npm run docs:api && cd ../../ && npm run build:eslint-inspector && npm run build:stylelint-inspector && cd docs/docusaurus && npx docusaurus build",
        "build:fast": "npx cross-env DOCUSAURUS_ENABLE_EXPERIMENTAL=true npx docusaurus build",
        "build:local": "npm run docs:api && npm run build:eslint-inspector:local && npm run build:stylelint-inspector:local && npx cross-env NODE_OPTIONS=--no-deprecation npx docusaurus build",
        "clear": "npx docusaurus clear",
        "deploy": "npx docusaurus deploy",
        "docs:api": "node ../../scripts/run-typedoc-docs.mjs --options typedoc.config.json",
        "docs:api:default": "node ../../scripts/run-typedoc-docs.mjs --options typedoc.config.json",
        "docusaurus": "npx docusaurus",
        "serve": "npx docusaurus serve",
        "start": "npx docusaurus start --host localhost",
        "type:css": "npx typed-css-modules .\\src",
        "typecheck": "npx tsc --project tsconfig.json --noEmit && npx tsc --project tsconfig.typedoc.json --noEmit",
        "write-heading-ids": "npx docusaurus write-heading-ids",
        "write-translations": "npx docusaurus write-translations"
    },
    "dependencies": {
        "@docusaurus/core": "^3.10.2",
        "@docusaurus/faster": "^3.10.2",
        "@docusaurus/plugin-content-docs": "^3.10.2",
        "@docusaurus/plugin-pwa": "^3.10.2",
        "@docusaurus/preset-classic": "^3.10.2",
        "@docusaurus/theme-mermaid": "^3.10.2",
        "@docusaurus/types": "^3.10.2",
        "@easyops-cn/docusaurus-search-local": "^0.55.3",
        "clsx": "^2.1.1",
        "prism-react-renderer": "^2.4.1"
    },
    "devDependencies": {
        "@docusaurus/module-type-aliases": "^3.10.2",
        "@docusaurus/tsconfig": "^3.10.2",
        "@eslint/config-inspector": "^3.2.0",
        "@mdx-js/react": "^3.1.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "docusaurus-plugin-image-zoom": "^3.0.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-github-btn": "^1.4.0",
        "typed-css-modules": "^0.9.1",
        "typedoc": "^0.28.20",
        "typedoc-config-nick2bad4u": "^2.0.3",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    },
    "packageManager": "npm@12.0.2",
    "engines": {
        "node": ">=20.19.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=20.19.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=11.0.0",
            "onFail": "error"
        }
    }
}
