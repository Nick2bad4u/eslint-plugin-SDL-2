{
    "$schema": "https://www.schemastore.org/tsconfig.json",
    "compilerOptions": {
        "incremental": true,
        "isolatedDeclarations": false,
        "noEmit": true,
        "tsBuildInfoFile": "./.cache/tsbuildinfo/tsconfig.benchmarks.tsbuildinfo",
        "types": [
            "node"
        ]
    },
    "exclude": [
        ".cache/**",
        "coverage/**",
        "dist/**",
        "docs/**",
        "node_modules/**",
        "reports/**",
        "temp/**"
    ],
    "extends": "./tsconfig.json",
    "include": [
        "benchmark/**/*.ts",
        "benchmarks/fixtures/**/*.ts",
        "src/**/*.ts",
        "test/fixtures/**/*.ts"
    ]
}
